# KPI Dashboard – Convex stack
# Copy to frontend/.env.local and set NEXT_PUBLIC_CONVEX_URL (or use `npx convex dev` to generate it).

# Frontend (local / Vercel)
NEXT_PUBLIC_CONVEX_URL=

# Convex backend env vars are set in Convex Dashboard (Settings → Environment Variables):
# - JWT_PRIVATE_KEY (RSA PEM for Convex Auth)
# - JWKS (JSON Web Key Set)
# - CONVEX_SITE_URL (your Convex site URL)
# Generate keys: cd frontend && node scripts/generate-auth-keys.mjs
